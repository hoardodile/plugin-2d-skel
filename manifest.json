	"ui": {
		"height": "85vh",
		"card": {
			"default": {
				"bl": [
					"{{join(' ', if(searchMeta.facets.ex, t('exKindLabel')), searchKindIcons(), if(gt(source.modelCount, 1), number(source.modelCount)))}}"
				],
				"br": [
					"{{if(source.width, join('', source.width, 'x', source.height))}}"
				]
			}
		},
		"search": {
			"kinds": [
				{
					"key": "live2d",
					"label": "{{t('live2dEngineLabel')}}",
					"icon": "{{icon('Swimming')}}"
				},
				{
					"key": "spine",
					"label": "{{t('spineEngineLabel')}}",
					"icon": "{{icon('WalkingRound')}}"
				},
				{
					"key": "dragonbones",
					"label": "{{t('dragonbonesEngineLabel')}}",
					"icon": "{{icon('Walking')}}"
				}
			]
		}
